---
import Layout from "@src/layouts/Layout.astro";
import {
  getStaticPaths,
  getLangFromUrl,
  useTranslations,
} from "@src/i18n/utils";

import groupPhotoImg from "@assets/imgs/group-foto.jpg";
import meerImg from "@assets/imgs/meer.jpg";
import { Image } from "astro:assets";
import fotoGallary from "@assets/imgs/impressie-img-gallary.webp";
import Aanbod from "@components/home/Aanbod.astro";
import Post from "@components/home/Post.astro";
import Welcome from "@components/home/Welcome.astro";

export { getStaticPaths };
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="home">
  <section
    class="intro text-white"
    style={`background-image: url(${meerImg.src});`}
  >
    <h1 class="text-align-center">{t("home.hero.title")}</h1>
  </section>
  <section class="bg-beige text-gray center roman-font">
    <p class="p1">
      <strong>{t("home.quote.author")}:</strong>
      {t("home.quote.text")}
    </p>
  </section>
  <section class="bg-green text-white center">
    <h2>{t("home.what.title")}</h2>
  </section>
  <section class="bg-beige center">
    <Image
      class="img"
      src={fotoGallary}
      alt={t("impressies.gallery.alt")}
      width={1000}
      height={500}
    />
  </section>
  <section class="bg-beige text-gray center">
    <div class="container small-text-margin">
      <p>{t("home.what.text1")}</p>
      <h2 class="text-green">{t("home.what.title1")}</h2>
      <p>{t("home.what.text2")}</p>
      <h2 class="text-green">{t("home.what.title2")}</h2>
      <p>{t("home.what.text3")}</p>
      <h2 class="text-green">{t("home.what.title3")}</h2>
      <p>{t("home.what.text4")}</p>
      <p>{t("home.what.text5")}</p>
    </div>
  </section>
  <section class="bg-beige text-gray center"></section>
  <section class="bg-green text-white center roman-font">
    <div class="text-margin text-align-center">
      <p class="p1">
        {t("home.cta.title")}
      </p>
    </div>
  </section>
  <Aanbod />
  <section class="bg-green text-align-center text-white">
    <div class="text-margin">
      <p class="p1 text-opacity-white">
        "Ik voel me enorm empowerd! Alsof ik gesteund word door een heel leger.
        Alsof ik mezelf de toestemming geef om helemaal brutaal, speels, wijs
        mezelf te zijn!"
      </p>
      <p>Nele</p>
    </div>
  </section>
  <Welcome />
  <Post />
  <section class="bg-beige text-gray center">
    <div class="small-text-margin us">
      <div class="img-wrapper">
        <Image
          alt={t("home.about.groupPhotoAlt")}
          width={400}
          height={400}
          src={groupPhotoImg}
          class="img"
        />
      </div>
      <div class="text">
        <h4 class="text-green">
          {t("home.about.contactTitle")}
        </h4>
        <div class="contact-container">
          <div class="contact">
            <p>{t("home.about.elkePhone")}</p>
            <p>{t("home.about.bramPhone")}</p>
            <p>
              {t("home.about.mail")}: <a href="mailto:info@reconstructive.be"
                >info@reconstructive.be</a
              >
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .intro {
    display: flex;
    align-items: flex-end;
    justify-content: center;

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    height: 500px;
  }

  .a-under-line {
    text-decoration: underline;
  }

  .yellow-line {
    border: 0;
    border-bottom: 2px solid #dec15b;
    width: 100%;
  }

  .us {
    display: grid;
    grid-template-columns: 1fr 2fr;
    column-gap: 3rem;
    row-gap: 2rem;
  }

  .us .img-wrapper {
    overflow: hidden;
    border-radius: 100%;
    aspect-ratio: 1/1;
    width: 100%;
    max-width: 200px;
    margin: auto;
    margin-right: 0;
  }

  .us .big.img-wrapper {
    max-width: 300px;
  }

  .us .img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .us p {
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .contact-card {
    text-align: left;
  }

  .blog .col2 {
    margin: 2rem 0;
    align-items: stretch;
  }
  @media (max-width: 800px) {
    .us {
      grid-template-columns: 1fr;
    }

    .us .img-wrapper {
      width: 50%;
      max-width: 250px;
      margin-left: auto;
      margin-right: auto;
    }

    .us .text {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
    }

    .us h3 {
      text-align: center;
    }
  }

  @media (max-width: 768px) {
    .intro {
      height: 300px;
    }
  }
</style>
