---
import { getLangFromUrl, useTranslations } from "@src/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
import AanbodCard from "@components/aanbod/AanbodCard.astro";
import grassPath from "@assets/imgs/grass-path.jpg";
import mountainPathImg from "@assets/imgs/mountain-path.jpg";
import AanbodDetails from "./AanbodDetails.astro";
---

<div class="grid">
  <div class="aanbodCardContainer">
    <div class="card-bg-slider"></div>
    <div class="card-wrapper" data-content="reconstructive" id="reconstructive">
      <AanbodCard
        title={t("aanbod.cards.reconstructive.title")}
        text={t("aanbod.cards.reconstructive.text")}
        alt={t("aanbod.cards.reconstructive.alt")}
        link="#"
        img={grassPath}
      />
    </div>
    <div class="card-wrapper" data-content="gold" id="gold">
      <AanbodCard
        title={t("aanbod.cards.gold.title")}
        text={t("aanbod.cards.gold.text")}
        alt={t("aanbod.cards.gold.alt")}
        link="#"
        img={mountainPathImg}
      />
    </div>
  </div>
  <div class="details text-gray text-margin" data-content="reconstructive">
    <AanbodDetails
      title={t("aanbod.details.reconstructive.title")}
      text={[
        t("aanbod.details.reconstructive.text1"),
        t("aanbod.details.reconstructive.text2"),
        t("aanbod.details.reconstructive.text3"),
        t("aanbod.details.reconstructive.text4"),
        t("aanbod.details.reconstructive.text5"),
        t("aanbod.details.reconstructive.text6"),
      ]}
      li={[
        t("aanbod.details.reconstructive.li1"),
        t("aanbod.details.reconstructive.li2"),
        t("aanbod.details.reconstructive.li3"),
        t("aanbod.details.reconstructive.li4"),
        t("aanbod.details.reconstructive.li5"),
      ]}
    />
  </div>
  <div class="details text-gray text-margin" data-content="gold">
    <AanbodDetails
      title={t("aanbod.details.gold.title")}
      text={[
        t("aanbod.details.gold.text1"),
        t("aanbod.details.gold.text2"),
        t("aanbod.details.gold.text3"),
        t("aanbod.details.gold.text4"),
        t("aanbod.details.gold.text5"),
      ]}
      li={[
        t("aanbod.details.gold.li1"),
        t("aanbod.details.gold.li2"),
        t("aanbod.details.gold.li3"),
        t("aanbod.details.gold.li4"),
      ]}
    />
  </div>
</div>

<script>
  const init = () => {
    const container = document.querySelector<HTMLElement>(
      ".aanbodCardContainer",
    );
    const cardWrappers =
      document.querySelectorAll<HTMLElement>(".card-wrapper");
    const details = document.querySelectorAll<HTMLElement>(".details");

    const contentIndexMap: Record<string, string> = {
      construct: "0",
      gold: "1",
    };

    const updateSlider = (contentName: string) => {
      if (!container) return;
      const index = contentIndexMap[contentName] || "0";
      container.style.setProperty("--active-index", index);
    };

    const setActiveCard = (
      contentName: string,
      shouldScroll: boolean = false,
    ) => {
      const targetContent = contentName || "construct";

      cardWrappers.forEach((cw) => {
        if (cw.dataset.content === targetContent) {
          cw.classList.add("active");
        } else {
          cw.classList.remove("active");
        }
      });

      updateSlider(targetContent);

      details.forEach((detail) => {
        if (detail.dataset.content === targetContent) {
          detail.classList.add("show");
          if (shouldScroll) {
            detail.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        } else {
          detail.classList.remove("show");
        }
      });
    };

    // 1. Actieve kaart en slider instellen op basis van de URL hash bij laden
    const initialHash = window.location.hash.replace("#", "");
    if (initialHash) {
      setActiveCard(initialHash, false);
      const cardWithContent = document.getElementById(initialHash);
      if (cardWithContent) {
        setTimeout(() => {
          cardWithContent.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }, 100);
      }
    } else {
      setActiveCard("construct", false);
    }

    // 2. Luisteren naar URL hash veranderingen (bijv. vanaf kalender of navigatie)
    const handleHashUpdate = () => {
      const hash = window.location.hash.replace("#", "");
      if (hash) {
        setActiveCard(hash, false);
        const cardWithContent = document.getElementById(hash);
        if (cardWithContent) {
          cardWithContent.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }
      }
    };

    window.addEventListener("hashchange", handleHashUpdate);
    window.addEventListener("popstate", handleHashUpdate);

    // 3. Document-wide link handler voor ankers op dezelfde pagina (bijv. "lees meer" in kalender)
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const anchor = target.closest("a");
      if (!anchor) return;

      const href = anchor.getAttribute("href");
      if (href && (href.includes("#construct") || href.includes("#gold"))) {
        const hashMatch = href.split("#")[1];
        if (hashMatch && (hashMatch === "construct" || hashMatch === "gold")) {
          const targetPath = anchor.pathname.replace(/\/$/, "");
          const currentPath = window.location.pathname.replace(/\/$/, "");

          if (targetPath === currentPath) {
            event.preventDefault();
            history.pushState(null, "", href);
            setActiveCard(hashMatch, false);
            const cardWithContent = document.getElementById(hashMatch);
            if (cardWithContent) {
              cardWithContent.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
            }
          }
        }
      }
    });

    // 4. Click handlers voor de kaarten (op de Aanbod pagina zelf)
    if (cardWrappers.length > 0) {
      cardWrappers.forEach((cardWrapper) => {
        cardWrapper.addEventListener("click", (event) => {
          event.preventDefault();
          const content = cardWrapper.dataset.content;

          if (!content) return;

          // Update URL hash
          history.replaceState(null, "", `#${content}`);

          const isMobile = window.matchMedia("(max-width: 800px)").matches;
          setActiveCard(content, isMobile);
        });
      });
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .grid {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
  }

  .aanbodCardContainer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 0;
    position: relative;
  }
  .card-wrapper {
    cursor: pointer;
    background-color: transparent;
    padding: 2rem 1.5rem;
    border-radius: 20px;
    position: relative;
    z-index: 1;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card-wrapper:not(.active):hover {
    transform: translateY(-8px);
  }

  .card-wrapper.active {
    opacity: 1 !important;
  }

  .aanbodCardContainer:has(.card-wrapper.active) .card-wrapper:not(.active) {
    opacity: 0.6;
  }

  /* Sliding Background Indicator */
  .card-bg-slider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc((100% - 2rem) / 2);
    left: 0;
    background-color: white;
    border-radius: 20px 20px 0 0;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
    box-shadow:
      0 -10px 25px rgba(0, 0, 0, 0.03),
      -10px 0 25px rgba(0, 0, 0, 0.03),
      10px 0 25px rgba(0, 0, 0, 0.03);
    z-index: 0;
    pointer-events: none;
    transform: translateX(calc(var(--active-index, 0) * (100% + 2rem)));
    opacity: 0;
  }

  .aanbodCardContainer:has(.card-wrapper.active) .card-bg-slider {
    opacity: 1;
  }

  /* Details op desktop */
  .details {
    grid-template-columns: 1fr 1fr;
    column-gap: 3rem;
    display: none;
    scroll-margin-top: 300px;
    background-color: white;
    padding: 3rem;
    border-radius: 0 0 20px 20px;
    margin: 0 auto 3rem auto;
    max-width: 1500px;
    box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.05);
    position: relative;
    z-index: 1;
  }

  .details.show {
    display: grid;
    animation: detailsFadeInContainer 0.5s cubic-bezier(0.16, 1, 0.3, 1)
      forwards;
  }

  .details.show > * {
    opacity: 0;
    animation: detailsFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .details.show > *:nth-child(1) {
    animation-delay: 0.05s;
  }
  .details.show > *:nth-child(2) {
    animation-delay: 0.18s;
  }

  @keyframes detailsFadeInContainer {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes detailsFadeIn {
    0% {
      opacity: 0;
      transform: translateY(15px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 800px) {
    :global(main),
    .grid,
    :parent {
      display: grid;
      grid-template-columns: 1fr;
    }

    .aanbodCardContainer {
      display: flex;
      flex-direction: column;
    }

    .card-bg-slider {
      display: none;
    }

    /* Marges corrigeren voor mobiel aangezien 'contents' de wrapper-marges wist */
    .card-wrapper {
      margin: 1rem 1.5rem;
      padding: 1.5rem;
      border-radius: 20px;
      transition:
        background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.4s ease;
    }

    .card-wrapper.active {
      transform: none; /* Geen opmerkelijke desktop-verschuivingen op mobiel */
      background-color: white;
      border-radius: 20px;
    }

    /* 4. Details tonen in 1 kolom onder de actieve kaart */
    .details.show {
      display: block;
      grid-template-columns: 1fr;
      padding: 1.5rem;
      margin: 1rem 1.5rem 2rem 1.5rem;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .details {
      scroll-margin-top: 0;
    }
  }
</style>
