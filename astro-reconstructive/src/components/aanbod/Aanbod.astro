---
import AanbodCard from "@components/aanbod/AanbodCard.astro";
import constructImg from "@assets/imgs/constructImg.jpg";
import mountainPathImg from "@assets/imgs/mountain-path.jpg";
import AanbodDetails from "./AanbodDetails.astro";
---

<div class="grid">
  <div class="aanbodCardContainer">
    <div class="card-bg-slider"></div>
    <div class="card-wrapper" data-content="construct" id="construct">
      <AanbodCard
        title="Voorbij je construct (1 dag)"
        text="Stap één dag buiten je vertrouwde patronen en ontdek hoeveel ruimte er ontstaat wanneer je je construct loslaat."
        link="#"
        alt="Foto van een plein met een bloem in het midden"
        img={constructImg}
      />
    </div>
    <div class="card-wrapper" data-content="gold" id="gold">
      <AanbodCard
        title="Find your gold (6 dagen)"
        text="Ga op een diepgaande reis door natuur en lichaam, en keer terug naar de essentie van wie jij werkelijk bent"
        link="#"
        alt="Foto van een houten pad door een dor veld met bergen in de achtergrond"
        img={mountainPathImg}
      />
    </div>
  </div>
  <div class="details text-gray text-margin" data-content="construct">
    <AanbodDetails
      title="Een ontmoeting"
      text={[
        " Een eerste ontmoeting met je essentie en met de reconstructive methode.",
        "Voor wie wilt proeven van wat er leeft voorbij je patronen",
        "Merk jij ook dat sommigen vrijer leven dan jij? Dat als jij iets wil veranderen, er meteen een stem in jouw hoofd zegt, 'ja maar, dat kan niet want...' Die stemmetjes bepalen mee hoe groot jouw vrijheid aanvoelt.",
        "Tijdens deze initiatiedag stap je uit je vertrouwde kaders. Via belevings-oefeningen en de wijsheid van de natuur word je uitgenodigd om buiten je construct te stappen. Het is alsof je een raam opent dat lang dicht zat. Er komt licht binnen. Ruimte. Nieuwsgierigheid.",
        "De natuur vindt altijd een weg ook in complexe omstandigheden. En precies dat herinnert jou eraan dat ook jij kunt bewegen, verschuiven, openen.",
      ]}
      li={[
        "Ruimer perspectief op je eigen patronen",
        "Een eerste ervaring van ruimte en vrijheid",
        "Meer bewustzijn over wat jou stuurt",
        "Nieuwsgierigheid als startpunt voor groei",
      ]}
    />
  </div>
  <div class="details text-gray text-margin" data-content="gold">
    <AanbodDetails
      title="Een thuiskomen"
      text={[
        "Een thuiskomen bij jezelf.",
        "Deze retreat is een innerlijke tocht waarbij we laag na laag dichterbij jouw blauwdruk komen, zodat zichtbaar wordt wie je altijd al was.",
        "Elke dag trekken we de natuur in. Ze spiegelt je zonder oordeel: waar je nog vasthoudt, waar je mag verzachten, waar je mag openen. De natuur laat zien wat je lichaam al wist, maar wat je hoofd misschien nog niet durfde te erkennen.",
        "Reconstructive maakt zichtbaar wat je onderweg tegenkomt: oude patronen, beschermingslagen, ingehouden emoties. Door ermee te werken in het lichaam komt er beweging, helderheid en richting. Je voelt hoe je dichter bij je blauwdruk komt dat stille, diepe weten van wie jij in essentie bent.",
        "De groep wordt een bedding. Je hoeft het niet alleen te doen, maar je maakt wel je eigen innerlijke reis.",
      ]}
      li={[
        "Meer helderheid",
        "belichaming",
        "rust",
        "stevig contact met je kern",
      ]}
    />
  </div>

  <script>
    const init = () => {
      const container = document.querySelector<HTMLElement>(
        ".aanbodCardContainer",
      );
      const cardWrappers =
        document.querySelectorAll<HTMLElement>(".card-wrapper");
      const details = document.querySelectorAll<HTMLElement>(".details");

      const contentIndexMap: Record<string, string> = {
        construct: "0",
        gold: "1",
      };

      const updateSlider = (contentName: string) => {
        if (!container) return;
        const index = contentIndexMap[contentName] || "0";
        container.style.setProperty("--active-index", index);
      };

      const setActiveCard = (contentName: string, shouldScroll: boolean = false) => {
        const targetContent = contentName || "construct";

        cardWrappers.forEach((cw) => {
          if (cw.dataset.content === targetContent) {
            cw.classList.add("active");
          } else {
            cw.classList.remove("active");
          }
        });

        updateSlider(targetContent);

        details.forEach((detail) => {
          if (detail.dataset.content === targetContent) {
            detail.classList.add("show");
            if (shouldScroll) {
              detail.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
            }
          } else {
            detail.classList.remove("show");
          }
        });
      };

      // 1. Actieve kaart en slider instellen op basis van de URL hash bij laden
      const initialHash = window.location.hash.replace("#", "");
      if (initialHash) {
        setActiveCard(initialHash, false);
        const cardWithContent = document.getElementById(initialHash);
        if (cardWithContent) {
          setTimeout(() => {
            cardWithContent.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }, 100);
        }
      } else {
        setActiveCard("construct", false);
      }

      // 2. Luisteren naar URL hash veranderingen (bijv. vanaf kalender of navigatie)
      const handleHashUpdate = () => {
        const hash = window.location.hash.replace("#", "");
        if (hash) {
          setActiveCard(hash, false);
          const cardWithContent = document.getElementById(hash);
          if (cardWithContent) {
            cardWithContent.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        }
      };

      window.addEventListener("hashchange", handleHashUpdate);
      window.addEventListener("popstate", handleHashUpdate);

      // 3. Document-wide link handler voor ankers op dezelfde pagina (bijv. "lees meer" in kalender)
      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const anchor = target.closest("a");
        if (!anchor) return;

        const href = anchor.getAttribute("href");
        if (href && (href.includes("#construct") || href.includes("#gold"))) {
          const hashMatch = href.split("#")[1];
          if (hashMatch && (hashMatch === "construct" || hashMatch === "gold")) {
            const targetPath = anchor.pathname.replace(/\/$/, "");
            const currentPath = window.location.pathname.replace(/\/$/, "");

            if (targetPath === currentPath) {
              event.preventDefault();
              history.pushState(null, "", href);
              setActiveCard(hashMatch, false);
              const cardWithContent = document.getElementById(hashMatch);
              if (cardWithContent) {
                cardWithContent.scrollIntoView({
                  behavior: "smooth",
                  block: "start",
                });
              }
            }
          }
        }
      });

      // 4. Click handlers voor de kaarten (op de Aanbod pagina zelf)
      if (cardWrappers.length > 0) {
        cardWrappers.forEach((cardWrapper) => {
          cardWrapper.addEventListener("click", (event) => {
            event.preventDefault();
            const content = cardWrapper.dataset.content;

            if (!content) return;

            // Update URL hash
            history.replaceState(null, "", `#${content}`);

            const isMobile = window.matchMedia("(max-width: 800px)").matches;
            setActiveCard(content, isMobile);
          });
        });
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
    document.addEventListener("astro:page-load", init);
  </script>

  <style>
    .grid {
      width: 100%;
      max-width: 1500px;
      margin: 0 auto;
    }

    .aanbodCardContainer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-bottom: 0;
      position: relative;
    }
    .card-wrapper {
      cursor: pointer;
      background-color: transparent;
      padding: 2rem 1.5rem;
      border-radius: 20px;
      position: relative;
      z-index: 1;
      transition:
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .card-wrapper:not(.active):hover {
      transform: translateY(-8px);
    }

    .card-wrapper.active {
      opacity: 1 !important;
    }

    .aanbodCardContainer:has(.card-wrapper.active) .card-wrapper:not(.active) {
      opacity: 0.6;
    }

    /* Sliding Background Indicator */
    .card-bg-slider {
      position: absolute;
      top: 0;
      bottom: 0;
      width: calc((100% - 2rem) / 2);
      left: 0;
      background-color: white;
      border-radius: 20px 20px 0 0;
      transition:
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.4s ease;
      box-shadow:
        0 -10px 25px rgba(0, 0, 0, 0.03),
        -10px 0 25px rgba(0, 0, 0, 0.03),
        10px 0 25px rgba(0, 0, 0, 0.03);
      z-index: 0;
      pointer-events: none;
      transform: translateX(calc(var(--active-index, 0) * (100% + 2rem)));
      opacity: 0;
    }

    .aanbodCardContainer:has(.card-wrapper.active) .card-bg-slider {
      opacity: 1;
    }

    /* Details op desktop */
    .details {
      grid-template-columns: 1fr 1fr;
      column-gap: 3rem;
      display: none;
      scroll-margin-top: 300px;
      background-color: white;
      padding: 3rem;
      border-radius: 0 0 20px 20px;
      margin: 0 auto 3rem auto;
      max-width: 1500px;
      box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.05);
      position: relative;
      z-index: 1;
    }

    .details.show {
      display: grid;
      animation: detailsFadeInContainer 0.5s cubic-bezier(0.16, 1, 0.3, 1)
        forwards;
    }

    .details.show > * {
      opacity: 0;
      animation: detailsFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .details.show > *:nth-child(1) {
      animation-delay: 0.05s;
    }
    .details.show > *:nth-child(2) {
      animation-delay: 0.18s;
    }

    @keyframes detailsFadeInContainer {
      0% {
        opacity: 0;
        transform: translateY(10px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes detailsFadeIn {
      0% {
        opacity: 0;
        transform: translateY(15px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 800px) {
      :global(main),
      .grid,
      :parent {
        display: grid;
        grid-template-columns: 1fr;
      }

      .aanbodCardContainer {
        display: flex;
        flex-direction: column;
      }

      .card-bg-slider {
        display: none;
      }

      /* Marges corrigeren voor mobiel aangezien 'contents' de wrapper-marges wist */
      .card-wrapper {
        margin: 1rem 1.5rem;
        padding: 1.5rem;
        border-radius: 20px;
        transition:
          background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.4s ease;
      }

      .card-wrapper.active {
        transform: none; /* Geen opmerkelijke desktop-verschuivingen op mobiel */
        background-color: white;
        border-radius: 20px;
      }

      /* 4. Details tonen in 1 kolom onder de actieve kaart */
      .details.show {
        display: block;
        grid-template-columns: 1fr;
        padding: 1.5rem;
        margin: 1rem 1.5rem 2rem 1.5rem;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      }

      .details {
        scroll-margin-top: 0;
      }
    }
  </style>
</div>
