---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "@src/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
import AnimationQuotes from "@components/AnimationQuotes.astro";
import AanbodCard from "@components/aanbod/AanbodCard.astro";
import constructImg from "@assets/imgs/constructImg.jpg";
import mountainPathImg from "@assets/imgs/mountain-path.jpg";
---

<section class="bg-beige text-gray center">
  <div class="container center text-align-center text-margin">
    <h2 class="text-green">{t("home.aanbod.title")}</h2>
    <p>{t("home.aanbod.intro1")}</p>
    <p>{t("home.aanbod.intro2")}</p>
    <p>{t("home.aanbod.noOrder")}</p>
    <hr class="full-yellow-line" />
    <div class="AanbodCardContainer">
      <AanbodCard
        title={t("home.aanbod.card1.title")}
        text={t("home.aanbod.card1.text")}
        link={translatePath("/aanbod/#construct")}
        alt={t("home.aanbod.card1.alt")}
        img={constructImg}
      />
      <AanbodCard
        title={t("home.aanbod.card3.title")}
        text={t("home.aanbod.card3.text")}
        link={translatePath("/aanbod/#gold")}
        alt={t("home.aanbod.card3.alt")}
        img={mountainPathImg}
      />
    </div>
    <hr class="full-yellow-line" />
    <a class="btn green-btn big-btn" href="mailto:info@reconstructive.be"
      >{t("home.aanbod.button")}</a
    >
  </div>
</section>
<AnimationQuotes />

<style>
  section {
    padding-bottom: 0;
  }
  .container {
    width: 100%;
    max-width: 1500px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
    box-sizing: border-box;
  }
  .AanbodCardContainer {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3rem;
    margin-bottom: 3rem;
    margin-left: 0;
    margin-right: 0;
    width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 1000px) {
    .AanbodCardContainer {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-top: 2rem;
      margin-bottom: 2rem;
    }
  }
</style>
